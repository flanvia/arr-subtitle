<Project>
  <PropertyGroup Condition="'$(OutputType)' == 'Exe' and ('$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'linux-arm64')">
    <StaticOpenSslLinking>true</StaticOpenSslLinking>
  </PropertyGroup>
  <Target Name="UsePinnedOpenSslArchives" AfterTargets="SetupOSSpecificProps" Condition="'$(StaticOpenSslLinking)' == 'true' and '$(OPENSSL_ROOT_DIR)' != ''">
    <Error Condition="!Exists('$(OPENSSL_ROOT_DIR)/lib/libssl.a') or !Exists('$(OPENSSL_ROOT_DIR)/lib/libcrypto.a')" Text="Pinned OpenSSL static archives are missing" />
    <ItemGroup>
      <StaticSslLibs Remove="-lssl -lcrypto" />
      <StaticSslLibs Include="$(OPENSSL_ROOT_DIR)/lib/libssl.a" />
      <StaticSslLibs Include="$(OPENSSL_ROOT_DIR)/lib/libcrypto.a" />
      <LinkerArg Remove="-lssl -lcrypto" />
      <LinkerArg Include="$(OPENSSL_ROOT_DIR)/lib/libssl.a" />
      <LinkerArg Include="$(OPENSSL_ROOT_DIR)/lib/libcrypto.a" />
    </ItemGroup>
  </Target>
</Project>
